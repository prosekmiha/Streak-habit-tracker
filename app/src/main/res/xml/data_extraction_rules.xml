<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: v Googlovo varnostno kopijo in pri prenosu na novo napravo gre le
  samodejni posnetek podatkov (snapshot/), nastavitve in videne znacke (da se po obnovi
  ne praznujejo znova). Sifrirana baza, njen kljuc, tekoca seja in dnevnik obvestil ostanejo na napravi
  (kljuc v Keystoru je vezan na napravo, zato baze drugje ne bi bilo mogoce odpreti).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="snapshot/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/gamification.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="snapshot/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/gamification.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
