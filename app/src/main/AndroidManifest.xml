<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ambientni zvok med sejo predvaja foreground storitev -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".StreakApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Streak"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Streak.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Deljenje izvozene varnostne kopije ali CSV -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Ambientni zvok med sejo (le, ko igra) -->
        <service
            android:name=".session.AmbientService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Dejanja obvestila seje in alarm za dosezen cilj -->
        <receiver
            android:name=".session.SessionReceiver"
            android:exported="false" />

        <!-- Opomnik navade in odlog -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- Dejanji opomnika: Opravljeno, Cez 15 min -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Jutranji povzetek in vecerni opomnik -->
        <receiver
            android:name=".notifications.DailyNotificationReceiver"
            android:exported="false" />

        <!-- Sprozi dnevni reset/briefing ob polnoci (natancen alarm) -->
        <receiver
            android:name=".notifications.DailyResetReceiver"
            android:exported="false" />

        <!-- Onemogoci privzeto WorkManager inicializacijo (uporabljamo Hilt Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Ponovno razporedi alarme: zagon, posodobitev, ura/pas, dovoljenje za natancne alarme -->
        <receiver
            android:name=".notifications.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Widgeti na domacem zaslonu (Glance) -->
        <receiver
            android:name=".widget.ProgressWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_progress_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_progress_info" />
        </receiver>
        <receiver
            android:name=".widget.HabitsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_habits_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habits_info" />
        </receiver>
        <receiver
            android:name=".widget.StreakWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_streak_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>
        <receiver
            android:name=".widget.QuantityWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quantity_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quantity_info" />
        </receiver>

        <!-- Izbira navade za widget streaka in kolicine -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Streak">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>
</manifest>
